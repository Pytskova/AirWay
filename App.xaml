<Application x:Class="AirlineApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="LoginWindow.xaml">
    <Application.Resources>
        <!-- Цветовая палитра -->
        <Color x:Key="PrimaryColor">#2E3A4F</Color>
        <Color x:Key="AccentColor">#4FC3F7</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="LightBrush" Color="#FFF"/>

        <!-- Общий стиль кнопки -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Стиль заголовка -->
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Специальный стиль для боковых кнопок дашбордов -->
        <Style x:Key="DashboardButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <!-- единая высота -->
            <Setter Property="Height" Value="40"/>
            <!-- минимальная ширина, чтобы все кнопки были одинаковыми -->
            <Setter Property="MinWidth" Value="160"/>
            <!-- растягиваем по ширине контейнера -->
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <!-- увеличенный шрифт -->
            <Setter Property="FontSize" Value="14"/>
            <!-- слегка меньше внутренние поля, чем у общего стиля -->
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Дополнительные стили размеров (по желанию) -->
        <Style x:Key="SmallButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="MediumButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="LargeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

    </Application.Resources>
</Application>
