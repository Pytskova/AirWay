<UserControl x:Class="AirlineApp.Views.Crew.CrewReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <!-- Кнопки Добавить/Изменить/Обновить -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="Добавить"   Click="AddReport_Click"   Width="80" Margin="0,0,8,0"/>
            <Button Content="Изменить"   Click="EditReport_Click"  Width="80" Margin="0,0,8,0"/>
            <Button Content="Обновить"   Click="Refresh_Click"     Width="80" Margin="0,0,8,0"/>
        </StackPanel>

        <TextBlock Text="Отчёты пилота" FontSize="16" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,10"/>

        <DataGrid x:Name="ReportsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <!-- Поля, которые вы проецируете в LoadReports(): -->
                <DataGridTextColumn Header="Дата отчёта"
                                    Binding="{Binding ReportDate}"
                                    Width="120"/>

                <DataGridTextColumn Header="Рейс"
                                    Binding="{Binding FlightNumber}"
                                    Width="100"/>

                <DataGridTextColumn Header="Вылет"
                                    Binding="{Binding Departure}"
                                    Width="80"/>

                <DataGridTextColumn Header="Прилёт"
                                    Binding="{Binding Arrival}"
                                    Width="80"/>

                <DataGridTextColumn Header="Топливо (л)"
                                    Binding="{Binding FuelUsed}"
                                    Width="80"/>

                <DataGridTextColumn Header="Статус рейса"
                                    Binding="{Binding Status}"
                                    Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
