<Window x:Class="AirlineApp.Views.Crew.AddPilotReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчёт пилота"
        Width="520" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource LightBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Рейс / Департюр -->
            <RowDefinition Height="Auto"/>
            <!-- Прибытие / Топливо -->
            <RowDefinition Height="Auto"/>
            <!-- Задержка -->
            <RowDefinition Height="*"/>
            <!-- Тексты -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Отчёт пилота"
                   Style="{StaticResource HeaderText}"
                   Grid.Row="0" Margin="0,0,0,20"/>

        <!-- Рейс + Дата/время вылета -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Рейс:" Grid.Column="0" VerticalAlignment="Center"/>
            <ComboBox x:Name="FlightBox"
                      Grid.Column="1" Margin="8,0"
                      Height="26"
                      DisplayMemberPath="FlightNumber"
                      SelectedValuePath="Id"/>

            <TextBlock Text="Вылет (факт):" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <DatePicker x:Name="DpDepartureDate"
                        Grid.Column="3" Height="26"/>
            <TextBox x:Name="TbDepartureTime"
                     Grid.Column="4"
                     Margin="6,0,0,0"
                     Height="26"
                     VerticalContentAlignment="Center"
                     Text="00:00"/>
        </Grid>

        <!-- Прибытие + Топливо -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Прилёт (факт):" Grid.Column="0" VerticalAlignment="Center"/>
            <DatePicker x:Name="DpArrivalDate"
                        Grid.Column="1" Height="26"/>
            <TextBox x:Name="TbArrivalTime"
                     Grid.Column="2"
                     Margin="6,0,0,0"
                     Height="26"
                     VerticalContentAlignment="Center"
                     Text="00:00"/>

            <TextBlock Text="Топливо (л):" Grid.Column="3" VerticalAlignment="Center"/>
            <TextBox x:Name="FuelBox"
                     Grid.Column="3" Margin="80,0,0,0"
                     Height="28"
                     VerticalContentAlignment="Center"
                     Padding="4"/>
        </Grid>

        <!-- Задержка -->
        <Border Grid.Row="3"
                BorderBrush="#DDD"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Задержка (мин):" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="DelayBox"
                         Grid.Column="1" Margin="8,0"
                         Height="28"
                         VerticalContentAlignment="Center"
                         Padding="4"/>
            </Grid>
        </Border>

        <!-- Текстовые поля -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="Причина задержки:"/>
            <TextBox x:Name="ReasonBox"
                     Height="60"
                     TextWrapping="Wrap"
                     Padding="6"
                     Margin="0,4,0,12"/>

            <TextBlock Text="Тех. проблемы:"/>
            <TextBox x:Name="TechBox"
                     Height="60"
                     TextWrapping="Wrap"
                     Padding="6"
                     Margin="0,4,0,12"/>

            <TextBlock Text="Погодные заметки:"/>
            <TextBox x:Name="WeatherBox"
                     Height="60"
                     TextWrapping="Wrap"
                     Padding="6"
                     Margin="0,4,0,12"/>

            <TextBlock Text="Прочие примечания:"/>
            <TextBox x:Name="RemarksBox"
                     Height="60"
                     TextWrapping="Wrap"
                     Padding="6"
                     Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Сохранить"
                    Width="100" Height="32"
                    Margin="0,0,8,0"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    Click="Save_Click"/>
            <Button Content="Отмена"
                    Width="100" Height="32"
                    Background="Transparent"
                    BorderBrush="{StaticResource AccentBrush}"
                    Foreground="{StaticResource AccentBrush}"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
