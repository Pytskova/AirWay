<UserControl x:Class="AirlineApp.Views.Crew.CrewHoursView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок с общим налётом -->
        <TextBlock x:Name="SummaryText"
                   FontSize="16"
                   FontWeight="Bold"
                   Text="Общий налёт: 0,00 ч"
                   Margin="0,0,0,12"/>

        <!-- Таблица: берем данные из PilotReports -->
        <DataGrid x:Name="LogsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата отчёта"
                                    Binding="{Binding ReportDate, StringFormat=\{0:dd.MM.yyyy\}}"
                                    Width="120"/>
                <DataGridTextColumn Header="Рейс"
                                    Binding="{Binding FlightNumber}"
                                    Width="100"/>
                <DataGridTextColumn Header="Вылет"
                                    Binding="{Binding ActualDeparture, StringFormat=\{0:HH:mm\}}"
                                    Width="80"/>
                <DataGridTextColumn Header="Прилёт"
                                    Binding="{Binding ActualArrival, StringFormat=\{0:HH:mm\}}"
                                    Width="80"/>
                <DataGridTextColumn Header="Продолжительность (ч)"
                                    Binding="{Binding DurationHours, StringFormat=N2}"
                                    Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
