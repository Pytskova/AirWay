<UserControl x:Class="AirlineApp.Views.Admin.ManageReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <!-- Только «Обновить» (данные из БД) -->
        <Button Content="Обновить" 
            DockPanel.Dock="Top" 
            Margin="0,0,0,10" 
            Click="Refresh_Click"/>

        <DataGrid x:Name="ReportsGrid"
              AutoGenerateColumns="False"
              ItemsSource="{Binding Reports}"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              IsReadOnly="True"
              SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"               Binding="{Binding Id}"                       Width="50"/>
                <DataGridTextColumn Header="Тип отчёта"       Binding="{Binding ReportType}"               Width="120"/>
                <DataGridTextColumn Header="Рег. номер ВС"    Binding="{Binding AircraftRegistration}"     Width="120"/>
                <DataGridTextColumn Header="Дата"             Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Сотрудник"        Binding="{Binding EmployeeName}"             Width="150"/>
                <DataGridTextColumn Header="Описание"         Binding="{Binding Description}"              Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
