<UserControl x:Class="AirlineApp.Views.ManageAircraftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <DockPanel Margin="10">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button x:Name="AddPlaneButton" Content="Добавить" Click="AddPlane_Click" Margin="0,0,5,0" />
            <Button x:Name="EditPlaneButton" Content="Изменить" Click="EditPlane_Click" Margin="0,0,5,0" />
            <Button x:Name="DeletePlaneButton" Content="Удалить" Click="DeletePlane_Click"  Margin="0,0,5,0" />
        </StackPanel>
        <DataGrid x:Name="AircraftDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Рег.№" Binding="{Binding RegistrationNumber}" Width="*"/>
                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="*"/>
                <DataGridTextColumn Header="Вместимость" Binding="{Binding Capacity}" Width="80"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>