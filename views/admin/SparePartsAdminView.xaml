<UserControl x:Class="AirlineApp.Views.Admin.SparePartsAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Справочник деталей"
                   FontWeight="Bold"
                   FontSize="16"
                   Margin="0 0 0 8"/>

        <DataGrid x:Name="PartsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название"
                                    Binding="{Binding PartName}"
                                    Width="150"/>
                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Quantity}"
                                    Width="80"/>
                <!-- Описание убрано -->
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Заявки на детали"
                   FontWeight="Bold"
                   FontSize="16"
                   Margin="0 8 0 8"
                   Grid.Row="2"/>

        <DataGrid x:Name="RequestsGrid"
                  Grid.Row="2"
                  Margin="0 30 0 0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Сотрудник"
                                    Binding="{Binding EmployeeName}"
                                    Width="120"/>
                <DataGridTextColumn Header="Деталь"
                                    Binding="{Binding PartName}"
                                    Width="120"/>
                <DataGridTextColumn Header="Кол-во"
                                    Binding="{Binding Quantity}"
                                    Width="80"/>
                <DataGridTextColumn Header="Причина"
                                    Binding="{Binding Reason}"
                                    Width="*"/>
                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding Status}"
                                    Width="90"/>
                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding RequestDate}"
                                    Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
