<Window x:Class="AirlineApp.Views.Admin.AssignCrewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Назначить экипаж" Height="600" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Фильтр -->
            <RowDefinition Height="*"/>
            <!-- Списки -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- 1. Фильтр по ролям -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Фильтр по роли:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="RoleFilter"
                      Width="200"
                      SelectionChanged="RoleFilter_SelectionChanged"/>
        </StackPanel>

        <!-- 2. Два больших "окна" со списками сотрудников -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Доступные -->
            <GroupBox Header="Доступные сотрудники"
                      Grid.Column="0"
                      Margin="0,0,10,0">
                <ListBox x:Name="AvailableList"
                         DisplayMemberPath="FullName"
                         SelectionMode="Extended"/>
            </GroupBox>

            <!-- Кнопки перемещения -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <Button Content="›"
                        Width="30" Height="30"
                        Margin="0,5"
                        Click="Add_Click"/>
                <Button Content="‹"
                        Width="30" Height="30"
                        Margin="0,5"
                        Click="Remove_Click"/>
            </StackPanel>

            <!-- Назначенные -->
            <GroupBox Header="Назначенные сотрудники"
                      Grid.Column="2"
                      Margin="10,0,0,0">
                <ListBox x:Name="AssignedList"
                         DisplayMemberPath="FullName"
                         SelectionMode="Extended"/>
            </GroupBox>
        </Grid>

        <!-- 3. Кнопки OK/Отмена -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="OK"
                    Width="70" Height="30"
                    Margin="0,0,10,0"
                    Click="Ok_Click"/>
            <Button Content="Отмена"
                    Width="70" Height="30"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
