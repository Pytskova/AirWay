<Window x:Class="AirlineApp.Views.Admin.AddEditMaintenanceScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить/Редактировать ТО"
        Height="320" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Самолет -->
            <RowDefinition Height="Auto"/>
            <!-- Техник -->
            <RowDefinition Height="Auto"/>
            <!-- Дата ТО -->
            <RowDefinition Height="*"/>
            <!-- Описание -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Бортовой номер (из Flights) -->
        <TextBlock Text="Бортовой номер:" 
                   Grid.Row="0" Grid.Column="0" 
                   VerticalAlignment="Center" Margin="0,0,5,10"/>
        <ComboBox x:Name="CbAircraft" 
                  Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

        <!-- Техник -->
        <TextBlock Text="Техник:" 
                   Grid.Row="1" Grid.Column="0" 
                   VerticalAlignment="Center" Margin="0,0,5,10"/>
        <ComboBox x:Name="CbTechnician" 
                  Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                  DisplayMemberPath="FullName"
                  SelectedValuePath="Id"/>

        <!-- Дата ТО -->
        <TextBlock Text="Дата ТО:" 
                   Grid.Row="2" Grid.Column="0" 
                   VerticalAlignment="Center" Margin="0,0,5,10"/>
        <DatePicker x:Name="DpDate" 
                    Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>

        <!-- Описание -->
        <TextBlock Text="Описание:" 
                   Grid.Row="3" Grid.Column="0" 
                   VerticalAlignment="Top" Margin="0,0,5,0"/>
        <TextBox x:Name="TbDescription"
                 Grid.Row="3" Grid.Column="1"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"/>

        <!-- Кнопки Сохранить/Отмена -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Сохранить" Width="80" Margin="0,0,10,0" Click="Save_Click"/>
            <Button Content="Отмена"    Width="80" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
