<UserControl x:Class="AirlineApp.Views.ManageEmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <DockPanel Margin="10">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button x:Name="AddButton" Content="Добавить" Click="AddButton_Click" Margin="0,0,5,0" />
            <Button x:Name="EditButton" Content="Изменить" Click="EditButton_Click" Margin="0,0,5,0" />
            <Button x:Name="DeleteButton" Content="Удалить" Click="DeleteButton_Click"  Margin="0,0,5,0" />
        </StackPanel>
        <DataGrid x:Name="EmployeesDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40" />
                <DataGridTextColumn Header="Логин" Binding="{Binding Username}" Width="*" />
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*" />
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="*" />
                <DataGridTextColumn Header="Налёт часов" Binding="{Binding FlightHours}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>