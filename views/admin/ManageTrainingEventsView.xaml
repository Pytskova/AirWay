<UserControl x:Class="AirlineApp.Views.Admin.ManageTrainingEventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AirlineApp.Views.Admin"
             xmlns:models="clr-namespace:AirlineApp.Models">
    <TabControl Margin="16">
        <!-- Вкладка 1: Курсы -->
        <TabItem Header="Курсы">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- DataGrid для курсов -->
                <DataGrid x:Name="EventsGrid"
                          Grid.Row="0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          Margin="0,0,0,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Тема"
                                            Binding="{Binding Topic}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Дата"
                                            Binding="{Binding EventDate, StringFormat=dd.MM.yyyy}"
                                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Кнопки -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Button Content="Добавить"
                            Width="100"
                            Margin="0,0,8,0"
                            Click="AddEvent_Click"/>
                    <Button Content="Редактировать"
                            Width="100"
                            Margin="0,0,8,0"
                            Click="EditEvent_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- Вкладка 2: Назначения -->
        <TabItem Header="Назначения">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Форма выбора -->
                <StackPanel Orientation="Horizontal"
                    Grid.Row="0"
                    Margin="0,0,0,12"
                    VerticalAlignment="Center">
                    <TextBlock Text="Сотрудник:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="EmployeeBox"
                      Width="200"
                      DisplayMemberPath="FullName"
                      Margin="8,0,0,0"/>

                    <TextBlock Text="Курс:" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <ComboBox x:Name="EventBox"
                      Width="200"
                      DisplayMemberPath="Topic"
                      Margin="8,0,0,0"/>

                    <Button x:Name="AssignButton"
                    Content="Назначить"
                    Width="100"
                    Margin="16,0,0,0"
                    Click="AssignToEvent_Click"/>
                </StackPanel>

                <!-- Таблица назначений -->
                <DataGrid x:Name="AssignmentsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Сотрудник"
                                    Binding="{Binding Employee.FullName}"
                                    Width="200"/>
                        <DataGridTextColumn Header="Курс"
                                    Binding="{Binding TrainingEvent.Topic}"
                                    Width="*"/>
                        <DataGridCheckBoxColumn Header="Пройдено"
                                        Binding="{Binding Passed}"
                                        Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

    </TabControl>
</UserControl>
    