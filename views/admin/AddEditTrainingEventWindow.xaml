<Window x:Class="AirlineApp.Views.Admin.AddEditTrainingEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить/Редактировать обучение"
        Height="202" Width="402"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Тема -->
            <RowDefinition Height="Auto"/>
            <!-- Дата -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Тема -->
        <TextBlock Text="Тема:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="TbTopic" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <!-- Дата -->
        <TextBlock Text="Дата:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <DatePicker x:Name="DpEventDate" Grid.Row="1" Grid.Column="1" Margin="5"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Сохранить" Width="90" Margin="0,0,10,0" Click="Save_Click"/>
            <Button Content="Отмена"     Width="90" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
