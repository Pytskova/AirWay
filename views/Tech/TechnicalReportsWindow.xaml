<UserControl x:Class="AirlineApp.Views.Tech.TechnicalReportsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="Auto" Width="Auto">
    <Grid Margin="16">
        <StackPanel>
            <TextBlock Text="Технические отчёты" FontWeight="Bold" FontSize="18" Margin="0,0,0,8"/>
            <DataGrid Name="ReportsGrid" AutoGenerateColumns="False" Height="250" IsReadOnly="True" Margin="0,0,0,8" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="40"/>
                    <DataGridTextColumn Header="Борт" Binding="{Binding AircraftRegistration}" Width="120"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding ReportDate}" Width="130"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Добавить" Width="100" Margin="0,0,8,0" Click="AddButton_Click"/>
                <Button Content="Изменить" Width="100" Margin="0,0,8,0" Click="EditButton_Click"/>
                <Button Content="Обновить" Width="100" Margin="0,0,8,0" Click="RefreshButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
