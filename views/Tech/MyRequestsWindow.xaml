<UserControl x:Class="AirlineApp.Views.Tech.MyRequestsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="Auto" Width="Auto">
    <Grid Margin="16">
        <StackPanel>
            <TextBlock Text="Мои заявки на детали" FontWeight="Bold" FontSize="18" Margin="0,0,0,8"/>
            <DataGrid Name="RequestsGrid" AutoGenerateColumns="False" Height="250" IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="40"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding PartName}" Width="*"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="60"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
                    <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="130"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding RequestDate}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
            <Button Content="Удалить заявку" Width="120" Click="DeleteRequest_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
