<Window x:Class="AirlineApp.Views.Tech.EditTechnicalReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать отчёт" Height="350" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Редактирование отчёта" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
            <TextBlock Text="Бортовой номер:"/>
            <TextBox Name="AircraftBox" Margin="0,2,0,8"/>
            <TextBlock Text="Дата:"/>
            <DatePicker Name="ReportDatePicker" Margin="0,2,0,8"/>
            <TextBlock Text="Описание:"/>
            <TextBox Name="DescriptionBox" Margin="0,2,0,8" Height="70" TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="110" Margin="0,0,10,0" Click="Save_Click"/>
            <Button Content="Отмена" Width="80" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
