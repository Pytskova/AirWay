<UserControl x:Class="AirlineApp.Views.Tech.MaintenanceScheduleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="Auto" Width="Auto">
    <Grid Margin="16">
        <StackPanel>
            <TextBlock Text="Расписание ТО" FontWeight="Bold" FontSize="18" Margin="0,0,0,8"/>
            <DataGrid Name="ScheduleGrid" AutoGenerateColumns="False" Height="300" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Борт" Binding="{Binding AircraftRegistration}" Width="120"/>
                    <DataGridTextColumn Header="Дата ТО" Binding="{Binding MaintenanceDate}" Width="130"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
